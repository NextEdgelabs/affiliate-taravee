# ─── API (apps/api) ─────────────────────────────────────────────
API_PORT=4000
# The API's own public base URL (used to build /api/r/:id redirect links)
PUBLIC_API_URL=http://localhost:4000
MONGODB_URI=mongodb://localhost:27017/taravee
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=taravee.sid
# PRODUCTION cookie scope. Normally LEAVE UNSET: the API auto-derives the shared
# parent of PUBLIC_API_URL + CORS_ORIGINS (e.g. api/admin/app.taaravi.com →
# .taaravi.com) so the session cookie reaches the dashboard subdomains. Set this
# only to override the derived value. (Local dev: leave unset — host-only.)
# SESSION_COOKIE_DOMAIN=
# Comma-separated list of allowed frontend origins (CORS + credentials).
# NOTE: the public storefront (3003) is intentionally NOT here — it is a
# separate non-credentialed surface.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
# Default admin seeded on first boot (REQUIRED + non-default in production)
ADMIN_EMAIL=admin@taravee.com
ADMIN_PASSWORD=admin12345
# Seed the demo creator? Auto-on in dev, never in production unless "true".
SEED_DEMO=true
# Salt for hashing click IPs (privacy — raw IPs are never stored)
CLICK_SALT=change-me

# ─── Shopify (single brand store) ───────────────────────────────
# Your PERMANENT store domain (not the custom storefront domain).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Optional custom storefront domain for buyer-facing redirect URLs
# SHOPIFY_STOREFRONT_DOMAIN=shop.taravee.com
SHOPIFY_API_VERSION=2025-01
# Base64 of 32 random bytes — encrypts the Admin API token at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SHOPIFY_TOKEN_ENC_KEY=

# App credentials from the Shopify DEV DASHBOARD (Settings → Credentials).
# NOTE: Shopify removed admin-created custom apps (no more pasteable shpat_
# token) for new apps as of Jan 1, 2026 — Dev Dashboard apps use these instead.
SHOPIFY_API_KEY=        # Client ID (32-hex)
SHOPIFY_API_SECRET=     # Client secret (shpss_…) — used for client-credentials, OAuth, webhook HMAC
SHOPIFY_SCOPES=read_products,read_orders
# Webhook signing secret = the same app Secret (shpss_…). For a legacy Custom
# App it is that app's separate webhook signing secret.
SHOPIFY_WEBHOOK_SECRET=
# Where to send the admin back after a successful OAuth connect.
ADMIN_URL=http://localhost:3001
#
# CONNECT OPTIONS (admin Shopify page), in order of preference for a store you own:
#  1) "Connect store you own" — client-credentials grant from SHOPIFY_API_KEY +
#     SHOPIFY_API_SECRET. No browser, no redirect URL. Requires the app and the
#     store to be in the SAME Dev Dashboard organization, app installed on the
#     store. Token lasts ~24h and is auto-refreshed. Needs API_KEY + SECRET + STORE_DOMAIN.
#  2) "Connect with Shopify" (OAuth) — needs a PUBLIC https PUBLIC_API_URL; set the
#     app's allowed redirect URL to ${PUBLIC_API_URL}/api/shopify/oauth/callback.
#  3) Paste an existing custom app's Admin API access token (shpat_…) — legacy.
# The "App automation token" (atkn_…) shown in the Dev Dashboard is a CI/CD deploy
# credential for Shopify CLI — it CANNOT call the Admin API; do not paste it here.

# ─── Public storefront (apps/storefront) ─────────────────────────
STOREFRONT_URL=http://localhost:3003

# ─── Frontends ──────────────────────────────────────────────────
# Per-app ports — mirror the `--port` flags in each app's package.json scripts.
ADMIN_PORT=3001
AFFILIATE_PORT=3002
STOREFRONT_PORT=3003
# admin + affiliate proxy /api to the backend (same-origin → first-party,
# isolated session cookie per app). API_ORIGIN is the backend origin they
# proxy to (and SSR calls directly). No /api suffix.
API_ORIGIN=http://localhost:4000
# Used by the public storefront (buy-button redirects + SSR reads).
NEXT_PUBLIC_API_URL=http://localhost:4000/api
